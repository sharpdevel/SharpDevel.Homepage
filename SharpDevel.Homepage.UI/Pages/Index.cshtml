@page
@model IndexModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@section Scripts
{
	<script type="text/javascript">
		function adjustFirstImageToScreenSize() {
			$('#content').css('top', $(window).height());
		}

		function scrollTo(element, offset) {
			offset = offset || 0;
			var scrollPosition = element.position().top;
			$("html, body").animate({ scrollTop: scrollPosition + offset + 'px' }, 1000, function () { });
		}

		function scrollDownButton(button, position, offset) {
			offset = offset || 0;
			$(button).click(function () {
				scrollTo($(position), offset);
			});
		}

		$(document).ready(function () {
			adjustFirstImageToScreenSize();
			var headerTop = $('header').position().top;

			if (window.location.href.endsWith("#imprint")) {
				$('#imprint').slideToggle();
			}

			$(document).scroll(function () {
				if ($(document).scrollTop() >= headerTop) {
					$('header').addClass('sticky');
					$('header #more').hide();
				}
				else {
					$('header').removeClass('sticky');
					$('header #more').show();
				}
			});

			$(window).resize(adjustFirstImageToScreenSize());

			$('#imprint_toggle').click(function () {
				$('#imprint').slideToggle();
				$('#contact').slideUp();
			});

			$('#contact_toggle, .contact_button').click(function () {
				$('#imprint').slideUp();
				$('#contact').slideToggle();
				$('#mail_success').hide();
			});

			$('.close').click(function () {
				$('#imprint').slideUp();
				$('#contact').slideUp();
			});

			$('#gdpr_link').click(function () {
				$('#contact').slideUp();
				$('#imprint').slideDown();
			});

			scrollDownButton('header #more', 'header')
			scrollDownButton('#es_logo', 'html')

			$('#send_message').click(function () {
				$('#mail_wait').show();
				$('#send_button').hide();
				var senderName = $("#senderName").val();
				var senderEmail = $("#senderEmail").val();
				var senderMessage = $("#senderMessage").val();

				var json = {
					senderName: senderName,
					senderEmail: senderEmail,
					senderMessage: senderMessage
				};

				$.ajax({
					url: "./api/Email",
					type: "Post",
					data: JSON.stringify(json),
					contentType: 'application/json; charset=utf-8',
					success: function (data) {
						$('#mail_success').show();
						$('#mail_wait').hide();
					},
					error: function (ex) {
						$('#mail_wait').hide();
						$('#send_button').show();
						alert("@Localizer["MailError"]");
					}
				});
			});
		});
	</script>
}

<video autoplay="autoplay" loop="loop" id="backgroundvideo">
	<source src="images/background.mov" type="video/mp4" />
</video>
<div id="center_content">
	<div id="first_impression">
		<div>
			<img id="portrait" src="Images/TobiasMundt.png" title="Tobias Mundt" alt="Tobias Mundt" />
		</div>
		<div id="myname">tobias mundt</div>
		<h1 id="profession">@Localizer["Profession"]</h1>
		<div id="mission">
			<p>
				@Localizer["MissionP1"]
			</p>
			<p>
				@Localizer["MissionP2"]
			</p>
			<p>
				@Localizer["MissionP3"]
			</p>
		</div>
		<div>
			<a href="#darkbird">
				<div id="brand">
					<img src="images/darkbird_xl.png" alt="Darkbird" title="Darkbird" />
				</div>
			</a>
		</div>
		<div>
			<a id="tellmemore_button" class="glow" href="https://www.darkbird.io">
				<span>@Localizer["TellMeMore"]</span>
			</a>
		</div>
	</div>
	<!-- Header -->
	<header>
		<div id="commands">
			<a id="es_logo">
				<img src="Images/TobiasMundt.png" alt="Home" title="Home" />
			</a>
			<a id="contact_toggle">
				<span class="fa-stack fa-1x">
					<i class="fal fa-circle fa-stack-2x button"></i>
					<i class="fas fa-phone fa-stack-1x fa-inverse button"></i>
				</span>
			</a>
			<a id="imprint_toggle">
				<span class="fa-stack fa-1x">
					<i class="fal fa-circle fa-stack-2x button"></i>
					<i class="fas fa-gavel fa-stack-1x fa-inverse button"></i>
				</span>
			</a>
		</div>
		<span class="fa-stack fa-lg" title="@Localizer["TellMeMoreTooltip"]" id="more">
			<i class="fal fa-circle fa-stack-2x button"></i>
			<i class="fal fa-caret-down fa-stack-1x fa-inverse button"></i>
		</span>
		<div id="social">
			<a href="https://www.facebook.com/tobias.mundt.98" target="_blank">
				<span class="fa-stack fa-1x" title="@Localizer["FollowFacebook"]">
					<i class="fal fa-circle fa-stack-2x button"></i>
					<i class="fab fa-facebook-f fa-stack-1x fa-inverse button"></i>
				</span>
			</a>
			<a href="https://twitter.com/tobias_mundt" target="_blank">
				<span class="fa-stack fa-1x" title="@Localizer["FollowTwitter"]">
					<i class="fal fa-circle fa-stack-2x button"></i>
					<i class="fab fa-twitter fa-stack-1x fa-inverse button"></i>
				</span>
			</a>
			<a href="https://www.instagram.com/tobiasmundt/" target="_blank">
				<span class="fa-stack fa-1x" title="@Localizer["FollowInstagram"]">
					<i class="fal fa-circle fa-stack-2x button"></i>
					<i class="fab fa-instagram fa-stack-1x fa-inverse button"></i>
				</span>
			</a>
		</div>
		<div id="copyright">
			tobias mundt<br />
			@Localizer["Copyright"]
		</div>
	</header>
	<!-- Content -->
	<div id="content">
		<!-- Darkbird -->
		<div id="darkbird">
			<div class="section_teaser parallax-window" data-parallax="scroll" data-image-src="images/parallax/sicherheitsdienst.jpg"></div>
			<div class="section_info">
				<div>
					<a href="https://www.darkbird.de" target="_blank">
						<img src="Images/darkbird.png" alt="dark.bird" title="dark.bird" class="section-logo" />
					</a>
				</div>
				<h2>
					@Localizer["DarkbirdClaim"]
				</h2>
				<a href="https://www.darkbird.de/">
					<div class="button">
						@Localizer["LearnMore"]
					</div>
				</a>
				<div>
					@Localizer["DarkbirdTagline"]
				</div>
			</div>
		</div>
		<!-- OpenSource -->
		<div id="opensource">
			<div class="section_teaser parallax-window" data-parallax="scroll" data-image-src="images/parallax/softwaredevelopment.jpg"></div>
			<div class="section_info">
				<div>
					<a href="https://github.com/everyday-solution" target="_blank">
						<img src="Images/opensource.png" alt="my open source projects on github" title="my open source projects on github" class="section-logo" />
					</a>
				</div>
				<h2>
					@Localizer["OpenSourceClaim"]
				</h2>
				<a href="https://github.com/everyday-solution" target="_blank">
					<div class="button">
						@Localizer["OpenSourceButton"]
					</div>
				</a>
				<div>
					@Localizer["OpenSourceTagline"]
				</div>
			</div>
		</div>
	</div>
	<!-- Imprint-->
	<div id="imprint">
		<a class="close button">
			<i class="fal fa-times-circle fa-2x" title="closClose"></i>
		</a>
		@if (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de")
		{
			<partial name="_ImprintDe" />
		}
		else
		{
			<partial name="_ImprintEn" />
		}
	</div>
	<!-- Contact -->
	<div id="contact">
		<a class="close button">
			<i class="fal fa-times-circle fa-2x" title="closClose"></i>
		</a>
		<h2>@Localizer["ContactHeading"]</h2>
		<label for="senderName">@Localizer["LabelName"]</label>
		<input id="senderName" title="senderName" />
		<label for="senderEmail">@Localizer["LabelEmail"]</label>
		<input id="senderEmail" title="senderEmail" />
		<label for="senderMessage">@Localizer["LabelMessage"]</label>
		<textarea id="senderMessage" title="senderMessage"></textarea>
		<div id="gdpr">
			@Localizer["GdprBeforeLink"] <span id="gdpr_link">@Localizer["GdprLinkText"]</span>.
		</div>
		<a id="send_message">
			<span class="fa-stack fa-2x" title="@Localizer["SendTitle"]" id="send_button">
				<i class="fal fa-circle fa-stack-2x button"></i>
				<i class="fas fa-paper-plane fa-stack-1x fa-inverse" style="color:lightgray"></i>
			</span>
			<img id="mail_wait" style="display:none;" src="Images/Wait.gif" title="@Localizer["Sending"]" alt="@Localizer["Sending"]" />
			<span id="mail_success" style="display:none;">@Localizer["MailSuccess"]</span>
		</a>
	</div>
</div>
